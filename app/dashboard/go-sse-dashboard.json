    {
      "type": "stat",
      "id": 5,
      "title": "HTTP 5xx ratio",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_ds}"
          },
          "refId": "A",
          "expr": "(sum(rate(sse_http_request_duration_seconds_count{job=~\"$job\",code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(sse_http_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "",
          "exemplar": false,
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
