            "uid": "${prometheus_ds}"
          },
          "refId": "A",
          "expr": "sum(rate(sse_http_requests_total{job=~\"$job\",path!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "",
          "exemplar": false,
          "instant": false,
