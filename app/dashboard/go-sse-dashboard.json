      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"$service\"} | detected_level=\"error\" [$__range])) or vector(0)",
