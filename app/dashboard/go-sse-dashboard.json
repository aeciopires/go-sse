  "description": "Observability for the go-sse Server-Sent Events application (Prometheus, Loki, Tempo).",
  "tags": [
    "go-sse",
    "sse",
    "prometheus",
    "loki",
    "tempo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "loki_ds",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "tempo_ds",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "query": {
          "query": "label_values(sse_build_info, job)",
          "refId": "job"
        },
        "definition": "label_values(sse_build_info, job)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {},
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service name",
        "type": "textbox",
        "query": "go-sse",
        "current": {
          "text": "go-sse",
          "value": "go-sse"
        },
        "hide": 0
      },
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "debug,info,warn,error",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Log search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
